# Copy to .env.local (git-ignored): cp .env.example .env.local
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time and are public: never put a secret here.
# RESTART `npm run dev` (or rebuild) after creating or changing this file; a running server keeps the old value.
# Origin of pathway-ai-backend (local Spring Boot API), without a trailing slash or path.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Protected staging / hosted deployment (server-only variables: NEVER prefix them with NEXT_PUBLIC_) ---
# The browser then calls this site's own /api/v1 proxy, which holds the backend address and the staging key:
#   NEXT_PUBLIC_API_BASE_URL=same-origin
#   API_UPSTREAM_URL=https://<backend-origin>       backend origin (https)
#   API_STAGING_KEY=<same value as the backend's STAGING_ACCESS_KEY>
#   SITE_BASIC_AUTH=<user>:<password>               password in front of every page and the proxy
#   PUBLIC_LAUNCH=true                              ONLY after the data-reuse rights are established; switches the password off
# A production build with neither SITE_BASIC_AUTH nor PUBLIC_LAUNCH=true answers 503 (fail closed).
